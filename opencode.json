{
  "$schema": "https://opencode.ai/config.json",
  "model": "internal/REPLACE-MODEL-ID",
  "provider": {
    "internal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Internal endpoint",
      "options": {
        "baseURL": "https://REPLACE-LLM-HOST/v1",
        "apiKey": "{env:LLM_API_KEY}"
      },
      "models": {
        "REPLACE-MODEL-ID": {
          "name": "Model"
        }
      }
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "edit": {
      "*": "allow",
      "*opencode.json": "ask",
      "*AGENTS.md": "ask",
      "*.opencode*": "ask",
      "*.obsidian*": "ask",
      "*.gitignore": "ask",
      "*.git": "deny"
    },
    "bash": {
      "*": "ask",
      "git log*": "allow",
      "git diff*": "allow",
      "git show*": "allow",
      "git status*": "allow",
      "powershell -NoProfile -Command \"Get-Date -Format yyyy-MM-dd\"": "allow",
      "powershell -NoProfile -ExecutionPolicy Bypass -File .opencode/scripts/vtt-to-md.ps1 -Remove *": "allow",
      "powershell -NoProfile -ExecutionPolicy Bypass -File .opencode/scripts/vtt-to-md.ps1 -Keep *": "allow",
      "*git commit*": "deny",
      "*git reset*": "deny",
      "*git checkout*": "deny",
      "*git restore*": "deny",
      "*git revert*": "deny",
      "*git rebase*": "deny",
      "*git stash*": "deny",
      "*git push*": "deny",
      "*git remote*": "deny",
      "*git clean*": "deny",
      "*git rm*": "deny",
      "rm *": "deny",
      "del *": "deny",
      "erase *": "deny",
      "rd *": "deny",
      "rmdir *": "deny",
      "*Remove-Item*": "deny"
    }
  }
}
