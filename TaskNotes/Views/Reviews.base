# Saved /review drafts and final reviews, across everyone.
filters:
  and:
    - file.hasTag("review")
    - '!file.inFolder("Templates")'

views:
  - type: table
    name: By year
    groupBy:
      property: year
      direction: DESC
    order:
      - file.name
      - person
      - kind
      - status
      - to
    sort:
      - property: person
        direction: ASC
      - property: to
        direction: DESC

  - type: table
    name: Drafts
    filters:
      and:
        - 'status == "draft"'
    order:
      - file.name
      - person
      - kind
      - to
