filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("Templates") && !file.inFolder("Examples")'
  - file.hasTag("research")
views:
- type: table
  name: Open
  filters:
    and:
    - status != "concluded" && status != "dropped"
  order:
  - file.name
  - area
  - status
  - question
  - projects
  - started
  sort:
  - property: started
    direction: DESC
- type: table
  name: Active
  filters:
    and:
    - status == "active"
  order:
  - file.name
  - area
  - kind
  - question
  - projects
  - started
  sort:
  - property: started
    direction: DESC
- type: table
  name: Ideas
  filters:
    and:
    - status == "idea"
  order:
  - file.name
  - area
  - kind
  - question
  - started
  sort:
  - property: started
    direction: DESC
- type: table
  name: Concluded
  filters:
    and:
    - status == "concluded" || status == "dropped"
  order:
  - file.name
  - area
  - kind
  - status
  - question
  - concluded
  sort:
  - property: concluded
    direction: DESC
