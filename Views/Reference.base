# All and How-tos are shared. Queries and verification checks are optional technical views.
filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("Templates") && !file.inFolder("Examples")'
  - file.hasTag("reference")
views:
- type: table
  name: All
  order:
  - file.name
  - kind
  - area
  - topics
  - projects
  - source
  sort:
  - property: file.name
    direction: ASC
- type: table
  name: How-tos
  filters:
    and:
    - kind == "how-to" || kind == "instructions"
  order:
  - file.name
  - area
  - topics
  - source
  sort:
  - property: file.name
    direction: ASC
- type: table
  name: Queries
  filters:
    and:
    - kind == "query"
  order:
  - file.name
  - systems
  - verified
  sort:
  - property: file.name
    direction: ASC
- type: table
  name: Not verified in a year
  filters:
    and:
    - kind == "query" || !systems.isEmpty() || !verified.isEmpty()
    - kind == "how-to" || kind == "instructions" || kind == "query"
    - verified.isEmpty() || date(verified) < today() - "365d"
  order:
  - file.name
  - kind
  - systems
  - verified
  sort:
  - property: verified
    direction: ASC
