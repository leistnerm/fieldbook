# Optional formal evaluations across people; not a default work dashboard or ordinary task review.
filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("Templates") && !file.inFolder("Examples")'
  - file.hasTag("review")
  - '!file.hasTag("task")'
views:
- type: table
  name: By year
  groupBy:
    property: year
    direction: DESC
  order:
  - file.name
  - person
  - kind
  - status
  - to
  sort:
  - property: person
    direction: ASC
  - property: to
    direction: DESC
- type: table
  name: Drafts
  filters:
    and:
    - status == "draft"
  order:
  - file.name
  - person
  - kind
  - to
