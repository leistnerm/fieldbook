# Embed in a project note: this is the host. Exact parent links roll up one level; missing links never match by a partial name.
filters:
  and:
  - file.ext == "md"
  - '!file.inFolder("Templates") && !file.inFolder("Examples")'
formulas:
  inTree: list(projects).contains(this.file.asLink()) || list(projects).filter(value.isType("link") && value.asFile()
    && list(value.asFile().properties.parent).contains(this.file.asLink())).length > 0
views:
- type: table
  name: Sub-projects
  filters:
    and:
    - file.hasTag("project")
    - list(parent).contains(this.file.asLink())
  order:
  - file.name
  - area
  - status
  - target
  sort:
  - property: status
    direction: ASC
- type: table
  name: Open tasks
  filters:
    and:
    - file.hasTag("task")
    - formula.inTree
    - status != "done" && status != "dropped"
  order:
  - file.name
  - area
  - projects
  - status
  - priority
  - assignee
  - due
  sort:
  - property: priority
    direction: ASC
  - property: due
    direction: ASC
- type: table
  name: Done last 90 days
  filters:
    and:
    - file.hasTag("task")
    - formula.inTree
    - recurrence.isEmpty()
    - status == "done"
    - '!completedDate.isEmpty()'
    - date(completedDate) >= today() - "89d"
    - date(completedDate) < today() + "1d"
  order:
  - file.name
  - area
  - projects
  - completedDate
  - assignee
  sort:
  - property: completedDate
    direction: DESC
- type: table
  name: Research
  filters:
    and:
    - file.hasTag("research")
    - formula.inTree
  order:
  - file.name
  - area
  - status
  - question
  - started
  sort:
  - property: started
    direction: DESC
- type: table
  name: Meetings
  filters:
    and:
    - file.hasTag("meeting")
    - formula.inTree
  order:
  - file.name
  - area
  - note.date
  - projects
  - series
  sort:
  - property: note.date
    direction: DESC
- type: table
  name: Decisions
  filters:
    and:
    - file.hasTag("decision")
    - formula.inTree
  order:
  - file.name
  - area
  - note.date
  - projects
  - status
  sort:
  - property: note.date
    direction: DESC
